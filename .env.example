# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it. This repo is PUBLIC.

# --- App ---
PORT=3003
# Any long random string; signs the session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# --- Furniture-shop API (from the event organizers) ---
SHOP_API_BASE_URL=https://day1.training.cognitivo.com.au
# Your personal event API key — treat like a password
SHOP_API_KEY=
# The event user id your key belongs to, e.g. u001
SHOP_API_USER_ID=

# --- Shared catalogue MongoDB (read-only, from the participant guide) ---
MONGODB_URI=

# --- Anthropic (Level 3 agent) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Optional Step 8 RAG sidecar; leave unset if not running ---
RAG_URL=http://localhost:8000
