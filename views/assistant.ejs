<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Assistant — Furniture Shop</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/header') %>
  <main class="chat-main">
    <div class="chat-header">
      <h2 class="page-title">Shopping assistant</h2>
      <div class="chat-actions">
        <a href="/chats" class="subtle-link">My chats</a>
        <form action="/assistant/new" method="post"><button type="submit" class="link-button subtle">New chat</button></form>
      </div>
    </div>
    <p class="notice">Ask in plain English — "find me a mustard chair under $500", "what's my balance?", "buy the first one".</p>
    <div id="chat" class="chat-log">
      <% for (const m of log) { %>
        <div class="chat-msg <%= m.role %>" data-raw="<%= m.text %>"><%= m.text %></div>
      <% } %>
      <% if (log.length === 0) { %>
        <div class="chat-msg assistant">Hi <%= currentUser.display_name %>! What are you looking for today?</div>
      <% } %>
    </div>
    <form id="chat-form" class="chat-form">
      <input id="chat-input" type="text" placeholder="Type your request…" autocomplete="off" autofocus>
      <button type="submit" class="button-primary">Send</button>
    </form>
  </main>
  <script>
    const chat = document.getElementById('chat');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input');
    const button = form.querySelector('button');

    // Minimal markdown renderer: escapes HTML first, then formats the
    // subset the model actually uses (bold, italic, code, lists).
    function renderMarkdown(text) {
      const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const lines = esc.split('\n');
      let html = '', inList = false;
      for (const line of lines) {
        const item = line.match(/^\s*(?:[-*•]|\d+[.)])\s+(.*)/);
        if (item) {
          if (!inList) { html += '<ul>'; inList = true; }
          html += '<li>' + item[1] + '</li>';
        } else {
          if (inList) { html += '</ul>'; inList = false; }
          if (line.trim()) html += '<p>' + line + '</p>';
        }
      }
      if (inList) html += '</ul>';
      return html
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\*([^*]+)\*/g, '<em>$1</em>')
        .replace(/`([^`]+)`/g, '<code>$1</code>');
    }

    // Any "(item 12345678)" ids in a reply become preview cards.
    async function addPreviews(div, text) {
      const ids = [...new Set([...text.matchAll(/item\s+([A-Za-z0-9-]{6,12})/g)].map(m => m[1]))];
      if (!ids.length) return;
      try {
        const res = await fetch('/api/products?ids=' + ids.join(','));
        const { products } = await res.json();
        if (!products.length) return;
        const row = document.createElement('div');
        row.className = 'chat-previews';
        for (const p of products) {
          const a = document.createElement('a');
          a.className = 'chat-preview-card';
          a.href = '/products/' + p.item_id;
          a.target = '_blank';
          a.innerHTML =
            (p.has_image ? `<img src="/products/${p.item_id}/image" alt="" loading="lazy">` : '') +
            `<span class="cp-name"></span><span class="cp-price">$${p.price.toFixed(2)}</span>`;
          a.querySelector('.cp-name').textContent = p.product_name;
          row.appendChild(a);
        }
        div.appendChild(row);
        chat.scrollTop = chat.scrollHeight;
      } catch {}
    }

    function addMsg(role, text) {
      const div = document.createElement('div');
      div.className = 'chat-msg ' + role;
      if (role === 'assistant') {
        div.innerHTML = renderMarkdown(text);
        addPreviews(div, text);
      } else {
        div.textContent = text;
      }
      chat.appendChild(div);
      chat.scrollTop = chat.scrollHeight;
      return div;
    }

    // Re-render server-provided history (raw text) as markdown + previews.
    for (const el of document.querySelectorAll('.chat-msg.assistant[data-raw]')) {
      const raw = el.getAttribute('data-raw');
      el.innerHTML = renderMarkdown(raw);
      addPreviews(el, raw);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      input.disabled = button.disabled = true;
      addMsg('user', text);
      const thinking = addMsg('assistant thinking', '…');
      try {
        const res = await fetch('/assistant/message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text }),
        });
        const data = await res.json();
        thinking.remove();
        addMsg('assistant', data.reply || data.error || 'Something went wrong.');
      } catch {
        thinking.remove();
        addMsg('assistant', 'Connection problem — please try again.');
      }
      input.disabled = button.disabled = false;
      input.focus();
    });
  </script>
</body>
</html>
