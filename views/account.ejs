<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My account — Furniture Shop</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/header') %>
  <main class="narrow">
    <h2 class="page-title">My account</h2>
    <% if (saved) { %><p class="success">Display name updated.</p><% } %>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <dl class="account-details">
      <dt>Name</dt>
      <dd>
        <form action="/account/display-name" method="post" class="name-form">
          <input type="text" name="display_name" value="<%= currentUser.display_name %>" maxlength="50" required>
          <button type="submit" class="button-primary small">Save</button>
        </form>
      </dd>
      <dt>Username</dt><dd><%= currentUser.username %></dd>
      <dt>Account type</dt>
      <dd><%= currentUser.account_type === 'linked' ? 'Linked to the live shop account' : 'Local demo account' %></dd>
      <% if (currentUser.account_type === 'local') { %>
        <dt>Balance</dt><dd>$<%= currentUser.balance.toFixed(2) %></dd>
      <% } else if (liveBalanceError) { %>
        <dt>Balance</dt><dd class="error-inline"><%= liveBalanceError %></dd>
      <% } else { %>
        <dt>Balance</dt><dd>$<%= liveBalance.toFixed(2) %> <span class="tag">live</span></dd>
      <% } %>
    </dl>
  </main>
</body>
</html>
